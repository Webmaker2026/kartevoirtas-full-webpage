# =====================================================================
# Production .htaccess — hagyományos Apache / LiteSpeed megosztott
# tárhelyhez készült. Minden rizikósabb szabály modul-ellenőrzéssel
# (<IfModule>) van körbevéve, hogy hiányzó modul esetén se okozzon
# 500-as hibát.
# =====================================================================

# ---------------------------------------------------------------------
# Egyedi hibaoldal — valódi HTTP 404 státusszal (nem 200 OK "szép" oldal)
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# Directory listing tiltása
# ---------------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------------
# Érzékeny / fejlesztési fájlok védelme
# ---------------------------------------------------------------------
<FilesMatch "(^\.env|^\.git|\.log$|\.sql$|\.bak$|\.zip$|\.sh$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# A .well-known (pl. SSL / domain-igazolás) mappát NE tiltsuk.
<FilesMatch "^\.well-known">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
# HTTPS átirányítás — csak akkor kapcsolja be (a kommentek eltávolításával),
# ha a végleges domainen már aktív és érvényes az SSL tanúsítvány.
# Enélkül a bekapcsolás redirect loopot okozhat.
# ---------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------------------------------------------------------------------
# www / non-www canonical host — a végleges domain ismeretében
# válasszon egy változatot, és távolítsa el a kommentet.
# ---------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------------------------------------------------------------------
# Biztonsági fejlécek (kompatibilitást szem előtt tartva)
# CSP és HSTS csak a tényleges script-/tag-követelmények, illetve
# a végleges, stabil HTTPS-konfiguráció ismeretében állítható be —
# ezért itt szándékosan nem szerepelnek.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------------------------------------------------------------------
# Tömörítés
# ---------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# Böngésző cache — statikus assetekre hosszabb, HTML/PHP-ra rövid cache
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 6 months"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php|json|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# UTF-8 alapértelmezett karakterkódolás
# ---------------------------------------------------------------------
AddDefaultCharset UTF-8
